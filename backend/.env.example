# Sin llaves, el backend responde 100% con la caché offline.
DATABASE_URL=sqlite:///./escudo.db

# openai | gemini
LLM_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=pega_aqui_tu_llave
GEMINI_MODEL=gemini-3.5-flash

LLM_TIMEOUT_SECONDS=15

# ── Análisis de comprobantes por imagen ──────────────────────────────────────
# Modelo con capacidad de visión (gemini-2.0-flash o gemini-1.5-flash).
# Si no se define, usa GEMINI_MODEL como fallback.
GEMINI_VISION_MODEL=gemini-2.0-flash

# Timeout para análisis de imágenes (las imágenes tardan más que texto puro)
LLM_IMAGE_TIMEOUT_SECONDS=20

# Tamaño máximo de imagen en MB
IMAGE_MAX_MB=5